# Python environments, caches and generated build metadata.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
# Local configuration and credentials. Reviewed templates remain publishable.
.env
.env.*
!.env.example
/secrets/
/credentials/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
# Data, experiments and build artifacts stay local. Publish reviewed lightweight
# reports under docs/experiments/ instead of copying whole run directories.
/dist/
/build/
/wandb/
/runs/
/outputs/
/checkpoints/
/artifacts/
/weights/
/data/
/tokenizers/
/tmp/
/scratch/
/.cache/
# Weight/data payloads and runtime logs, including files accidentally written
# outside the standard local directories.
*.pt
*.pth
*.bin
*.ckpt
*.gguf
*.onnx
*.safetensors
*.parquet
*.arrow
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
events.out.tfevents.*
*.log
.DS_Store
